{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "zig build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "build debug",
            "type": "shell",
            "command": "zig build -Doptimize=Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "build release",
            "type": "shell",
            "command": "zig build -Doptimize=ReleaseFast",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "run",
            "type": "shell",
            "command": "zig build run",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "rm -rf zig-out zig-cache .zig-cache",
            "windows": {
                "command": "cmd /c \"rmdir /s /q zig-out zig-cache .zig-cache\""
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
